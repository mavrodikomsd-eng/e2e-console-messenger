# ═══════════════════════════════════════════════════════
# MeshMessenger .gitignore
# ═══════════════════════════════════════════════════════

# ── Бинарники Windows ──
*.exe

# ── Rust ──
rust_gui/target/
rust_client/target/
**/target/

# ── Go ──
go_client/mesh_go_client.exe

# ── Python ──
__pycache__/
*.py[cod]
*$py.class
venv/
env/
ENV/
.venv/

# ── Zig ──
zig_client/zig-out/

# ── Секреты и данные пользователя ──
secret.key
identity.key
accounts.json
tofu.json
messages.txt
messages.log

# ── Загруженные файлы ──
downloads/

# ── Данные ──
data/

# ── IDE и редакторы ──
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# ── Системные файлы ──
Thumbs.db
Desktop.ini
.DS_Store
*.log

# ── Docker ──
test_build/

# ── AI-агент (рабочие заметки, не для публикации) ──
ai_agent/

# ── Временные эксперименты ──
_xc*
_hst*
_rt*
_scratch*
*xc_probe*
